<?xml version="1.0" encoding="utf-8"?>
<objects>
    <!-- Dynamic/important objects -->
    <object Name="Ursa_NeverhomeDoor" Inherits="Door">
        <part Name="Render" DisplayName="pneumatic door" ColorString="&amp;c" TileColor="&amp;c" DetailColor="Y" Tile="Objects/Ursa_NeverhomeDoor.png" />
        <part Name="Description" Short="A hermetically sealed passageway locked by a touchless keycard, somehow still working. Once-pristine glass filters light through a millenia's worth of dust and fungal growths. One might have seen through it, but that dream is long dead." />
        <part Name="Door" Locked="true" KeyObject="Ursa_NeverhomeKey" ClosedTile="Objects/Ursa_NeverhomeDoor.png" OpenTile="Objects/Ursa_NeverhomeDoorOpen.png" />
        <stat Name="AV" Value="25" />
        <stat Name="Hitpoints" Value="1000" />
        <tag Name="UrahiahUnlock" />
    </object>

    <object Name="Ursa_NeverhomeKey" Inherits="Security Card">
        <part Name="Render" DisplayName="vinyl keycard" RenderString="-" ColorString="&amp;B" Occluding="false" RenderIfDark="true" Tile="Items/sw_security_card.bmp" />
        <part Name="Commerce" Value="200" />
        <stat Name="AV" Value="25" />
        <stat Name="Hitpoints" Value="500" />
        <part Name="Description" Short="A scratched, flexible keycard. It's printed with indecipherable text and pictographs, buffed nearly clean by years of changing hands. 'Ne&#x4;&#xDB;r&#xDB;&#xDB;m&#x4;'" />
        <tag Name="NoSparkingQuest" />
        <tag Name="QuestItem" />
		<part Name="CompleteQuestOnTaken" Quest="If You Die in a River..." QuestStep="Rob Urahiah's key" />
		<part Name="Interesting" Radius="1" />
    </object>

    <object Name="Ursa_Cryotube" Inherits="Ursa_Lunarian">
        <part Name="Render" DisplayName="static womb" RenderString="U" Tile="Objects/Ursa_Cryotube.png" ColorString="&amp;C" DetailColor="O"/>
        <stat Name="AV" Value="25" />
        <stat Name="Hitpoints" Value="200" />
        <part Name="Description" Short="An embryonic mass of flesh writhes in warm static, behind the scuffed and scratched glass of this artificial womb." />
        <part Name="Physics" Weight="200" Takeable="false" />
        <part Name="Brain" Hostile="false" Wanders="false" Mobile="false" Factions="Playerneutral-100" />
        <tag Name="DeathSounds" Value="Sounds/Damage/sfx_destroy_glass" />
		<tag Name="CustomDeathMessage" Value="A horrific embryo =verb:crawl= from the warmth of =subject.t=..." />

        <!-- Bursting cryotube: kills the object when a player allied creature walks beside it -->
        <part Name="UrsaBurstingCryotube" />
        <!-- Leave a corpse that is the burst cryotube furniture and the enemy -->
        <part Name="UrsaPopulationCorpse" PopulationName="UrsaCryochamber" />
    </object>

    <object Name="Ursa_BustedCryotube" Inherits="Furniture">
        <part Name="Render" DisplayName="broken compact cryochamber" RenderString="U" Tile="Objects/Ursa_BrokenCryotube.png" ColorString="&amp;C" DetailColor="O"/>
        <stat Name="AV" Value="25" />
        <stat Name="Hitpoints" Value="200" />
        <part Name="Description" Short="" />
        <part Name="Physics" Weight="200" Takeable="false" />
    </object>
    
    <!-- Decorations -->

    <object Name="Ursa_CrooningLamina" Inherits="Plant">
        <part Name="Render" DisplayName="crooning lamina" RenderString="231" Tile="Objects/Ursa_CrooningLamina.png" ColorString="&amp;C" DetailColor="m" Occluding="false" />
        <part Name="Description" Short="Atop a great craning spine, diaphanous tendrils bat the air with prying interest. Wherever the forking boughs sway, a dense haze of violet trails close behind." />
        <stag Name="Luxury" />
		<stag Name="Beauty" />
    </object>

    <object Name="Ursa_Lipocinth" Inherits="Plant">
        <part Name="Render" DisplayName="lipocinth" RenderString="231" Tile="Objects/Ursa_Lipocinth.png" ColorString="&amp;C" DetailColor="O" Occluding="false" />
        <part Name="Description" Short="Hot globes of pressurised fat are suspended in leaf-mimicry. Running down an orb's amber seam, a substance akin to marmalade quietly leaves a coral stain on the ground. They wiggle with an unsettling jauntiness." />
        <stag Name="Luxury" />
		<stag Name="Beauty" />
    </object>

    <object Name="Ursa_ExamTable" Inherits="Furniture">
        <part Name="Render" DisplayName="surgical table" RenderString="242" Tile="Objects/Ursa_ExamTable.png" ColorString="&amp;C" DetailColor="Y" Occluding="false" />
        <part Name="Description" Short="omnimouse table..." />
        <part Name="Physics" Weight="100" Takeable="false" />
    </object>
</objects>